<% layout("/layouts/boilerplate") %> 

<!-- Filters & Tax Switch Bar -->
<div class="d-flex align-items-center justify-content-between flex-wrap my-3">
  <!-- Airbnb Filter Categories UI -->
  <div id="filters">
    <div class="filter active">
      <i class="fa-solid fa-fire"></i>
      <p>Trending</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-bed"></i>
      <p>Rooms</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-mountain-city"></i>
      <p>Iconic Cities</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-mountain"></i>
      <p>Mountains</p>
    </div>
    <div class="filter">
      <i class="fa-brands fa-fort-awesome"></i>
      <p>Castles</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-person-swimming"></i>
      <p>Amazing Pools</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-campground"></i>
      <p>Camping</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-cow"></i>
      <p>Farms</p>
    </div>
    <div class="filter">
      <i class="fa-regular fa-snowflake"></i>
      <p>Arctic</p>
    </div>
    <div class="filter">
      <i class="fa-solid fa-umbrella-beach"></i>
      <p>Beachfront</p>
    </div>
  </div>

  <!-- Tax Switch Toggle (Text first, button after text) -->
  <div class="tax-toggle ms-auto mt-2 mt-md-0">
    <div class="form-check form-switch d-flex align-items-center gap-3 mb-0" style="padding-left: 0;">
      <label class="form-check-label fw-semibold" for="taxSwitch" style="font-size: 0.85rem; cursor: pointer; user-select: none;">
        Display total after taxes
      </label>
      <input class="form-check-input ms-0" type="checkbox" role="switch" id="taxSwitch" style="cursor: pointer; font-size: 1.15rem;">
    </div>
  </div>
</div>

<!-- Listing Cards Grid -->
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <% for(let listing of allListings){ %>
    <div class="col position-relative">
      <!-- Like (Heart) Button -->
      <button class="like-btn" onclick="toggleLike(event, this)" title="Save to favorites">
        <i class="fa-regular fa-heart"></i>
      </button>

      <a href="/listings/<%= listing._id  %>" class="listing-link">
        <div class="card listing-card">
          <img src="<%= typeof listing.image === 'object' && listing.image ? listing.image.url : listing.image %>"
            class="card-img-top" alt="listing_image" style="height: 20rem; object-fit: cover;" />
          <div class="card-img-overlay"></div>
          <div class="card-body mt-2">
            <p class="card-text mb-0">
              <b style="color: #222;"><%= listing.title %></b>
            </p>
            <p class="card-text text-muted mb-0" style="font-size: 0.9rem;">
              <%= listing.location %>, <%= listing.country %>
            </p>
            <p class="card-text mt-1" style="color: #222;">
              <span class="fw-semibold">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></span> /night
              <i class="tax-info">&nbsp; &nbsp;+18% GST</i>
            </p>
          </div>
        </div>
      </a>
    </div>
  <% } %>
</div>

<!-- Tax Switch & Like Button Interactive Logic -->
<script>
  // Toggle Tax Info (+18% GST)
  const taxSwitch = document.getElementById("taxSwitch");
  if (taxSwitch) {
    function updateTaxDisplay() {
      const taxInfoBadges = document.getElementsByClassName("tax-info");
      for (let info of taxInfoBadges) {
        if (taxSwitch.checked) {
          info.style.display = "inline";
        } else {
          info.style.display = "none";
        }
      }
    }

    taxSwitch.addEventListener("change", updateTaxDisplay);
    taxSwitch.addEventListener("click", updateTaxDisplay);
  }

  // Like Heart Toggle Functionality
  function toggleLike(event, btn) {
    event.preventDefault(); // Prevent navigating to the listing page
    event.stopPropagation();
    const icon = btn.querySelector("i");
    if (icon.classList.contains("fa-regular")) {
      icon.classList.remove("fa-regular");
      icon.classList.add("fa-solid");
      btn.classList.add("liked");
    } else {
      icon.classList.remove("fa-solid");
      icon.classList.add("fa-regular");
      btn.classList.remove("liked");
    }
  }

  // Filter click active visual state
  const filters = document.querySelectorAll(".filter");
  filters.forEach(filter => {
    filter.addEventListener("click", () => {
      filters.forEach(f => f.classList.remove("active"));
      filter.classList.add("active");
    });
  });
</script>